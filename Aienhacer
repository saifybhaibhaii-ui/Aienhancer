import { db, setJob } from './db.js';
import { deletePrefix, keys } from './store.js';
import { refund } from './quota.js';

export async function deleteJobData(job: { id: string; user_id: string }) {
  await deletePrefix(keys.prefix(job.user_id, job.id));         // throws if anything remains
  await db.query(
    `update jobs set status='deleted', original_key=null, output_key=null, plan=null, qc=null,
       original_sha256=null, output_sha256=null where id=$1`, [job.id]);
}

export function startSweepers() {
  setInterval(async () => {
    const due = await db.many(`select id,user_id from jobs where expires_at < now() and status <> 'deleted' limit 200`);
    for (const j of due) await deleteJobData(j).catch((e) => console.error('retention_failed', j.id, e.message));
  }, 10 * 60_000);

  // watchdog: no job may sit in a non-terminal state forever
  setInterval(async () => {
    const stuck = await db.many(
      `select id from jobs where status in ('queued','analyzing','enhancing','face_restoring','checking')
         and updated_at < now() - interval '15 minutes'`);
    for (const j of stuck) {
      await setJob(j.id, { status: 'failed', progress: 100, error_code: 'timeout',
        error_message: 'This took too long and was stopped. Your credit was returned. Please try again.' });
      await refund(j.id);
    }
  }, 60_000);
}
