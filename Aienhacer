// apps/api/src/analyze.ts
import sharp from 'sharp';
import { identity } from './identity.js';

export interface FaceBox { x: number; y: number; w: number; h: number; score: number }

export interface Analysis {
  width: number; height: number; long: number;
  sharpness: number;      // Laplacian variance on a 512px proxy
  noiseSigma: number;     // Immerkaer estimate on the proxy, 0-255 scale
  meanLuma: number;
  contrastSpan: number;   // p99 - p1 of luminance
  bytesPerPixel: number;  // low values suggest heavy compression
  faces: FaceBox[];
  faceDetectorAvailable: boolean;
}

/** Decode any supported input to an auto-oriented sRGB PNG working copy. */
export async function toWorkPng(input: Buffer): Promise<Buffer> {
  try {
    return await sharp(input, { limitInputPixels: 60_000_000 }).rotate().png().toBuffer();
  } catch (err) {
    const brand = input.subarray(4, 12).toString('ascii');
    if (/ftyp(heic|heix|mif1|hevc)/.test(brand)) {
      // Prebuilt sharp lacks HEVC decoding, so fall back to a JS/WASM decoder.
      const { default: convert } = await import('heic-convert');
      const jpeg = Buffer.from(await convert({ buffer: input, format: 'JPEG', quality: 1 }));
      return sharp(jpeg).rotate().png().toBuffer();
    }
    throw err;
  }
}

export function lapVar(g: Uint8Array, w: number, h: number): number {
  let s = 0, s2 = 0, n = 0;
  for (let y = 1; y < h - 1; y++) {
    for (let x = 1; x < w - 1; x++) {
      const i = y * w + x;
      const v = -4 * g[i] + g[i - 1] + g[i + 1] + g[i - w] + g[i + w];
      s += v; s2 += v * v; n++;
    }
  }
  const m = s / n;
  return s2 / n - m * m;
}

function noiseSigma(g: Uint8Array, w: number, h: number): number {
  let sum = 0;
  for (let y = 1; y < h - 1; y++) {
    for (let x = 1; x < w - 1; x++) {
      const i = y * w + x;
      const v =
        g[i - w - 1] - 2 * g[i - w] + g[i - w + 1] -
        2 * g[i - 1] + 4 * g[i] - 2 * g[i + 1] +
        g[i + w - 1] - 2 * g[i + w] + g[i + w + 1];
      sum += Math.abs(v);
    }
  }
  return (sum * Math.sqrt(0.5 * Math.PI)) / (6 * (w - 2) * (h - 2));
}

export async function analyze(work: Buffer, originalBytes: number): Promise<Analysis> {
  const meta = await sharp(work).metadata();
  const width = meta.width!, height = meta.height!;
  const { data, info } = await sharp(work)
    .resize({ width: 512, height: 512, fit: 'inside', withoutEnlargement: true })
    .greyscale().raw().toBuffer({ resolveWithObject: true });

  const hist = new Uint32Array(256);
  let sum = 0;
  for (const v of data) { hist[v]++; sum += v; }
  const pct = (p: number) => {
    let acc = 0; const target = data.length * p;
    for (let i = 0; i < 256; i++) { acc += hist[i]; if (acc >= target) return i; }
    return 255;
  };

  const det = await identity.detect(work);
  return {
    width, height, long: Math.max(width, height),
    sharpness: lapVar(data, info.width, info.height),
    noiseSigma: noiseSigma(data, info.width, info.height),
    meanLuma: sum / data.length,
    contrastSpan: pct(0.99) - pct(0.01),
    bytesPerPixel: originalBytes / (width * height),
    faces: det.faces,
    faceDetectorAvailable: det.available,
  };
}
