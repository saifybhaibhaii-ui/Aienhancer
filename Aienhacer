import sharp from 'sharp';
import { lapVar, type FaceBox } from './analyze.js';
import { MODES, type ModeId } from './modes.js';

export interface Check { name: string; pass: boolean; value?: number | string; limit?: string }
export interface QcResult { pass: boolean; checks: Check[] }

const gray = async (buf: Buffer, w: number, h: number) =>
  (await sharp(buf).resize(w, h, { fit: 'fill' }).greyscale().raw().toBuffer());

async function centerCrop(buf: Buffer, W: number, H: number, size = 1024) {
  const w = Math.min(size, W), h = Math.min(size, H);
  const { data } = await sharp(buf)
    .extract({ left: Math.floor((W - w) / 2), top: Math.floor((H - h) / 2), width: w, height: h })
    .greyscale().raw().toBuffer({ resolveWithObject: true });
  return { data, w, h };
}

/**
 * `baseline` is the original resized with Lanczos to the target size. It is the
 * "what you'd get without AI" reference every metric is measured against.
 * Thresholds are starting heuristics. Calibrate them on your own test set.
 */
export async function runQc(p: {
  output: Buffer; baseline: Buffer; expected: { w: number; h: number };
  originalAspect: number; mode: ModeId; faces: FaceBox[];
  identityResults: { similarity: number | null; accepted: boolean }[];
}): Promise<QcResult> {
  const spec = MODES[p.mode];
  const checks: Check[] = [];
  const add = (c: Check) => checks.push(c);

  // 1. file integrity: a full decode must succeed
  let W = 0, H = 0;
  try {
    const meta = await sharp(p.output).metadata();
    await sharp(p.output).stats();
    W = meta.width ?? 0; H = meta.height ?? 0;
    add({ name: 'integrity', pass: W > 0 && H > 0 && ['png', 'jpeg'].includes(meta.format ?? '') });
  } catch { add({ name: 'integrity', pass: false }); return { pass: false, checks }; }

  // 2. exact dimensions, 3. aspect ratio
  add({ name: 'dimensions', pass: W === p.expected.w && H === p.expected.h, value: `${W}x${H}`, limit: `${p.expected.w}x${p.expected.h}` });
  const aspectErr = Math.abs(W / H - p.originalAspect) / p.originalAspect;
  add({ name: 'aspect_ratio', pass: aspectErr < 0.005 || Math.abs(W - Math.round(H * p.originalAspect)) <= 1, value: aspectErr.toFixed(5) });

  // 4. missing or blank sections: 8x8 grid on a 64x64 proxy
  const [go, gb] = await Promise.all([gray(p.output, 64, 64), gray(p.baseline, 64, 64)]);
  let worst = 0, blank = 0;
  for (let by = 0; by < 8; by++) for (let bx = 0; bx < 8; bx++) {
    let d = 0, mo = 0, mb = 0, so = 0, sb = 0;
    for (let y = 0; y < 8; y++) for (let x = 0; x < 8; x++) {
      const i = (by * 8 + y) * 64 + bx * 8 + x;
      d += Math.abs(go[i] - gb[i]); mo += go[i]; mb += gb[i];
    }
    mo /= 64; mb /= 64;
    for (let y = 0; y < 8; y++) for (let x = 0; x < 8; x++) {
      const i = (by * 8 + y) * 64 + bx * 8 + x;
      so += (go[i] - mo) ** 2; sb += (gb[i] - mb) ** 2;
    }
    worst = Math.max(worst, d / 64);
    if (Math.sqrt(so / 64) < 1 && Math.sqrt(sb / 64) > 10) blank++;
  }
  add({ name: 'missing_regions', pass: worst < 60 && blank === 0, value: `maxBlockDiff=${worst.toFixed(1)}, blank=${blank}` });

  // 5. colour consistency: mean RGB on a tiny proxy
  const mean = async (b: Buffer) => (await sharp(b).resize(32, 32, { fit: 'fill' }).removeAlpha().stats()).channels.map((c) => c.mean);
  const [mo, mb] = await Promise.all([mean(p.output), mean(p.baseline)]);
  const dRGB = Math.max(...mo.map((v, i) => Math.abs(v - mb[i])));
  add({ name: 'color_consistency', pass: dRGB <= spec.colorTolerance, value: dRGB.toFixed(1), limit: `<=${spec.colorTolerance}` });

  // 6. sharpness and over-sharpening: native-resolution centre crop
  const [co, cb] = await Promise.all([centerCrop(p.output, W, H), centerCrop(p.baseline, W, H)]);
  const ratio = lapVar(co.data, co.w, co.h) / Math.max(lapVar(cb.data, cb.w, cb.h), 1e-6);
  add({ name: 'sharpness', pass: ratio >= spec.minSharpnessRatio && ratio <= spec.maxSharpnessRatio, value: ratio.toFixed(2), limit: `${spec.minSharpnessRatio}-${spec.maxSharpnessRatio}` });

  // 7. clipping: new blown-out or crushed pixels (artifact proxy)
  const clip = (g: Buffer) => { let c = 0; for (const v of g) if (v < 2 || v > 253) c++; return c / g.length; };
  const clipDelta = clip(go) - clip(gb);
  add({ name: 'clipping', pass: clipDelta < 0.03, value: clipDelta.toFixed(3) });

  // 8. plastic skin: face texture must not collapse relative to the baseline
  if (p.faces.length && p.mode !== 'noise_cleaner') {
    const f = [...p.faces].sort((a, b) => b.w * b.h - a.w * a.h)[0];
    const box = { left: Math.max(0, Math.round(f.x)), top: Math.max(0, Math.round(f.y)),
      width: Math.min(Math.round(f.w), W - Math.round(f.x)), height: Math.min(Math.round(f.h), H - Math.round(f.y)) };
    if (box.width > 24 && box.height > 24) {
      const crop = async (b: Buffer) => sharp(b).extract(box).greyscale().raw().toBuffer({ resolveWithObject: true });
      const [a, c] = await Promise.all([crop(p.output), crop(p.baseline)]);
      const r = lapVar(a.data, a.info.width, a.info.height) / Math.max(lapVar(c.data, c.info.width, c.info.height), 1e-6);
      add({ name: 'skin_texture', pass: r >= 0.6, value: r.toFixed(2), limit: '>=0.6' });
    }
  }

  // 9. identity: every attempted face restoration must have been accepted or rejected explicitly
  const unmeasured = p.identityResults.filter((r) => r.accepted && r.similarity === null).length;
  add({ name: 'identity_checked', pass: unmeasured === 0, value: `${p.identityResults.length} face(s), ${unmeasured} unmeasured accepted` });

  return { pass: checks.every((c) => c.pass), checks };
}
