import { cfg } from './config.js';
import type { FaceBox } from './analyze.js';

const post = async <T>(path: string, body: unknown): Promise<T> => {
  const r = await fetch(`${cfg.IDENTITY_URL}${path}`, {
    method: 'POST', headers: { 'content-type': 'application/json' },
    body: JSON.stringify(body), signal: AbortSignal.timeout(20_000),
  });
  if (!r.ok) throw new Error(`identity_service_${r.status}`);
  return r.json() as Promise<T>;
};

export const identity = {
  available: () => !!cfg.IDENTITY_URL,

  async detect(img: Buffer): Promise<{ available: boolean; faces: FaceBox[] }> {
    if (!cfg.IDENTITY_URL) return { available: false, faces: [] };
    try {
      const r = await post<{ faces: FaceBox[] }>('/detect', { image: img.toString('base64') });
      return { available: true, faces: r.faces };
    } catch { return { available: false, faces: [] }; }
  },

  /** Cosine similarity of face embeddings. Returns null when it can't be measured. */
  async similarity(a: Buffer, b: Buffer): Promise<number | null> {
    if (!cfg.IDENTITY_URL) return null;
    try {
      const r = await post<{ similarity: number | null }>('/compare', {
        a: a.toString('base64'), b: b.toString('base64'),
      });
      return r.similarity;
    } catch { return null; }
  },
};
