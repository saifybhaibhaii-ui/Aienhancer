import { Queue, Worker } from 'bullmq';
import { cfg } from './config.js';
import { processJob } from './pipeline.js';

const connection = { url: cfg.REDIS_URL } as any;
export const queue = new Queue('enhance', { connection });

export const enqueue = (jobId: string, premium: boolean) =>
  queue.add('enhance', { jobId }, {
    jobId,                                   // BullMQ ignores duplicate ids, so a second enqueue is harmless
    priority: premium ? 1 : 10,              // lower number = served first (faster premium queue)
    attempts: 1, removeOnComplete: 1000, removeOnFail: 1000,
  });

export const startWorker = () =>
  new Worker('enhance', async (j) => {
    await Promise.race([
      processJob(j.data.jobId),
      new Promise((_, rej) => setTimeout(() => rej(new Error('job_timeout')), 8 * 60_000)),
    ]);
  }, { connection, concurrency: cfg.WORKER_CONCURRENCY });
