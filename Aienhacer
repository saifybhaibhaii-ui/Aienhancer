const POLICY_VERSION = '2026-11-01';

const CreateJob = z.object({
  mode: z.enum(Object.keys(MODES) as [keyof typeof MODES, ...(keyof typeof MODES)[]]),
  intensity: z.number().int().min(0).max(100).optional(),
  faceRestore: z.boolean().default(true),
  faceStrength: z.number().int().min(0).max(100).default(100),
  exportFormat: z.enum(['png', 'jpeg']).default('jpeg'),
  contentType: z.enum(['image/jpeg', 'image/png', 'image/webp', 'image/heic', 'image/heif']),
  consent: z.object({ processing: z.literal(true), training: z.boolean().default(false) }),
});

export async function routes(app: FastifyInstance) {
  app.decorateRequest('user', null as any);
  app.addHook('preHandler', async (req, reply) => {
    if (req.url === '/health' || req.url.startsWith('/webhooks/')) return;
    try {
      const token = (req.headers.authorization ?? '').replace(/^Bearer /, '');
      const { payload } = await jwtVerify(token, JWKS, { issuer: cfg.AUTH_ISSUER });
      const u = await db.one(
        `insert into users(id) values($1) on conflict (id) do update set id=excluded.id returning *`, [payload.sub]);
      (req as any).user = u;
    } catch { return reply.code(401).send({ code: 'unauthorized' }); }
  });

  app.get('/health', async () => ({ ok: true }));

  app.get('/v1/me', async (req: any) => {
    const used = (await db.one(`select coalesce(sum(used),0)::int as used from usage_daily where user_id=$1 and day=(now() at time zone 'utc')::date`, [req.user.id])).used;
    return { plan: req.user.plan, creditsUsedToday: used, dailyLimit: dailyLimit(req.user.plan), retentionHours: cfg.RETENTION_HOURS, policyVersion: POLICY_VERSION };
  });

  app.post('/v1/jobs', { config: { rateLimit: { max: 20, timeWindow: '1 minute' } } }, async (req: any, reply) => {
    const idem = String(req.headers['idempotency-key'] ?? '');
    if (idem.length < 8) return reply.code(400).send({ code: 'idempotency_key_required' });
    const body = CreateJob.safeParse(req.body);
    if (!body.success) return reply.code(400).send({ code: 'invalid_request', issues: body.error.issues });
    const b = body.data, user = req.user, spec = MODES[b.mode];

    const dup = await db.oneOrNone('select * from jobs where user_id=$1 and idempotency_key=$2', [user.id, idem]);
    if (dup) return reply.code(200).send(publicJob(dup));                       // duplicate-request protection

    if (spec.tier === 'premium' && user.plan !== 'premium')
      return reply.code(402).send({ code: 'premium_required', message: `${spec.label} is a Premium mode.` });

    const active = await db.one(`select count(*)::int c from jobs where user_id=$1 and status in ('queued','analyzing','enhancing','face_restoring','checking')`, [user.id]);
    if (active.c >= 2) return reply.code(429).send({ code: 'too_many_active', message: 'Two photos are already processing. Please wait for one to finish.' });

    const client = await pool.connect();
    try {
      await client.query('begin');
      if (!(await reserve(client, user.id, user.plan, spec.credits))) {
        await client.query('rollback');
        return reply.code(429).send({ code: 'daily_limit', message: 'Daily credit limit reached. It resets at 00:00 UTC.' });
      }
      await client.query(`insert into consents(user_id,kind,policy_version,granted) values ($1,'upload_processing',$2,true),($1,'training',$2,$3)`,
        [user.id, POLICY_VERSION, b.consent.training]);
      const row = (await client.query(
        `insert into jobs(user_id,idempotency_key,mode,intensity,face_restore,face_strength,export_format,status,credits_charged,expires_at)
         values($1,$2,$3,$4,$5,$6,$7,'awaiting_upload',$8, now() + ($9 || ' hours')::interval) returning *`,
        [user.id, idem, b.mode, b.intensity ?? spec.defaultIntensity, b.faceRestore, b.faceStrength, b.exportFormat, spec.credits, String(cfg.RETENTION_HOURS)])).rows[0];
      await client.query('commit');
      const key = keys.original(user.id, row.id);
      const post = await presignUpload(key, cfg.MAX_UPLOAD_BYTES, b.contentType);
      await db.query('update jobs set original_key=$2 where id=$1', [row.id, key]);
      return { job: publicJob(row), upload: post };
    } catch (e) { await client.query('rollback').catch(() => {}); throw e; }
    finally { client.release(); }
  });

  app.post('/v1/jobs/:id/start', async (req: any, reply) => {
    const job = await ownJob(req, reply); if (!job) return;
    if (job.status !== 'awaiting_upload') return publicJob(job);                 // idempotent
    const size = await headSize(job.original_key);
    if (!size) return reply.code(409).send({ code: 'upload_missing', message: 'We did not receive your photo. Please upload it again.' });
    if (size > cfg.MAX_UPLOAD_BYTES) return reply.code(413).send({ code: 'too_big' });
    const buf = await getBuffer(job.original_key);
    let w = 0, h = 0;
    try {
      const m = await sharp(buf, { limitInputPixels: cfg.MAX_PIXELS }).metadata();       // real decode check, never trusts Content-Type
      w = m.width ?? 0; h = m.height ?? 0;
    } catch {
      // HEIC without a native decoder is handled later by toWorkPng. Anything else is rejected.
      if (!/ftyp(heic|heix|mif1|hevc)/.test(buf.subarray(4, 12).toString('ascii')))
        return reply.code(415).send({ code: 'unsupported_image', message: "We couldn't read that file as a photo." });
    }
    await setJob(job.id, { status: 'queued', progress: 2, original_bytes: size, original_w: w || null, original_h: h || null,
      original_sha256: createHash('sha256').update(buf).digest('hex') });
    await enqueue(job.id, (req.user.plan === 'premium'));
    return publicJob(await db.one('select * from jobs where id=$1', [job.id]));
  });

  app.get('/v1/jobs', async (req: any) =>
    (await db.many(`select * from jobs where user_id=$1 and status<>'deleted' order by created_at desc limit 50`, [req.user.id])).map(publicJob));

  app.get('/v1/jobs/:id', async (req: any, reply) => { const j = await ownJob(req, reply); return j && publicJob(j); });

  app.get('/v1/jobs/:id/files/:variant', async (req: any, reply) => {
    const j = await ownJob(req, reply); if (!j) return;
    const variant = req.params.variant;
    if (variant === 'output' && j.status !== 'succeeded') return reply.code(409).send({ code: 'not_ready' });
    const key = variant === 'original' ? j.original_key : variant === 'output' ? j.output_key : null;
    if (!key) return reply.code(404).send({ code: 'gone', message: 'This file has been deleted.' });
    const ext = variant === 'output' ? (j.export_format === 'png' ? 'png' : 'jpg') : 'orig';
    return { url: await presignGet(key, 300, `hdglow-${j.id.slice(0, 8)}-${variant}.${ext}`), expiresInSeconds: 300,
             sha256: variant === 'output' ? j.output_sha256 : j.original_sha256 };
  });

  app.delete('/v1/jobs/:id', async (req: any, reply) => {
    const j = await ownJob(req, reply); if (!j) return;
    await deleteJobData(j);
    return { deleted: true };
  });

  app.delete('/v1/me/data', async (req: any) => {
    const mine = await db.many(`select id,user_id from jobs where user_id=$1 and status<>'deleted'`, [req.user.id]);
    for (const j of mine) await deleteJobData(j);
    return { deleted: mine.length };
  });
}

async function ownJob(req: any, reply: any) {
  const j = await db.oneOrNone('select * from jobs where id=$1 and user_id=$2', [req.params.id, req.user.id]);
  if (!j) { reply.code(404).send({ code: 'not_found' }); return null; }
  return j;
}

const publicJob = (j: any) => ({
  id: j.id, status: j.status, progress: j.progress, mode: j.mode, intensity: j.intensity,
  faceRestore: j.face_restore, exportFormat: j.export_format,
  original: j.original_w ? { width: j.original_w, height: j.original_h, bytes: Number(j.original_bytes) } : null,
  output: j.output_w ? { width: j.output_w, height: j.output_h, bytes: Number(j.output_bytes), label: j.output_label, sha256: j.output_sha256 } : null,
  explanation: j.plan?.reasons ?? [], error: j.error_code ? { code: j.error_code, message: j.error_message } : null,
  expiresAt: j.expires_at,
});
