import base64, cv2, numpy as np
from fastapi import FastAPI
from pydantic import BaseModel
from insightface.app import FaceAnalysis

# LICENSING: InsightFace's pretrained packs are non-commercial research only.
# For a commercial product, license them or swap in an embedding model you may use commercially.
fa = FaceAnalysis(name="buffalo_l", providers=["CPUExecutionProvider"])
fa.prepare(ctx_id=-1, det_size=(640, 640))
app = FastAPI()

def dec(b64: str):
    return cv2.imdecode(np.frombuffer(base64.b64decode(b64), np.uint8), cv2.IMREAD_COLOR)

class One(BaseModel): image: str
class Two(BaseModel): a: str; b: str

@app.post("/detect")
def detect(r: One):
    img = dec(r.image)
    faces = fa.get(img)
    return {"faces": [
        {"x": int(f.bbox[0]), "y": int(f.bbox[1]),
         "w": int(f.bbox[2] - f.bbox[0]), "h": int(f.bbox[3] - f.bbox[1]),
         "score": float(f.det_score)} for f in faces if f.det_score > 0.5]}

@app.post("/compare")
def compare(r: Two):
    fa_, fb_ = fa.get(dec(r.a)), fa.get(dec(r.b))
    if not fa_ or not fb_:
        return {"similarity": None}          # unmeasurable, so the caller must treat it as a fail
    a = max(fa_, key=lambda f: f.det_score).normed_embedding
    b = max(fb_, key=lambda f: f.det_score).normed_embedding
    return {"similarity": float(np.dot(a, b))}
