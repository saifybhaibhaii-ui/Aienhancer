import {
  S3Client, PutObjectCommand, GetObjectCommand, HeadObjectCommand,
  DeleteObjectsCommand, ListObjectsV2Command,
} from '@aws-sdk/client-s3';
import { getSignedUrl } from '@aws-sdk/s3-request-presigner';
import { createPresignedPost } from '@aws-sdk/s3-presigned-post';
import { cfg } from './config.js';

const s3 = new S3Client({ region: cfg.S3_REGION, endpoint: cfg.S3_ENDPOINT, forcePathStyle: !!cfg.S3_ENDPOINT });
const Bucket = cfg.S3_BUCKET;

export const keys = {
  prefix: (u: string, j: string) => `u/${u}/${j}/`,
  original: (u: string, j: string) => `u/${u}/${j}/original`,
  work: (u: string, j: string, n: string) => `u/${u}/${j}/work/${n}.png`,
  output: (u: string, j: string, ext: string) => `u/${u}/${j}/output.${ext}`,
};

export const presignUpload = (Key: string, maxBytes: number, contentType: string) =>
  createPresignedPost(s3, {
    Bucket, Key, Expires: 600,
    Conditions: [['content-length-range', 1, maxBytes], ['eq', '$Content-Type', contentType]],
    Fields: { 'Content-Type': contentType },
  });

export const presignGet = (Key: string, ttl = 300, filename?: string) =>
  getSignedUrl(s3, new GetObjectCommand({
    Bucket, Key,
    ResponseContentDisposition: filename ? `attachment; filename="${filename}"` : undefined,
  }), { expiresIn: ttl });

export async function getBuffer(Key: string): Promise<Buffer> {
  const r = await s3.send(new GetObjectCommand({ Bucket, Key }));
  return Buffer.from(await r.Body!.transformToByteArray());
}
export const putBuffer = (Key: string, Body: Buffer, ContentType: string) =>
  s3.send(new PutObjectCommand({ Bucket, Key, Body, ContentType, ServerSideEncryption: 'AES256' }));

export async function headSize(Key: string): Promise<number | null> {
  try { return (await s3.send(new HeadObjectCommand({ Bucket, Key }))).ContentLength ?? null; }
  catch { return null; }
}

export async function deletePrefix(Prefix: string): Promise<void> {
  let token: string | undefined;
  do {
    const l = await s3.send(new ListObjectsV2Command({ Bucket, Prefix, ContinuationToken: token }));
    const objs = (l.Contents ?? []).map((o) => ({ Key: o.Key! }));
    if (objs.length) await s3.send(new DeleteObjectsCommand({ Bucket, Delete: { Objects: objs } }));
    token = l.NextContinuationToken;
  } while (token);
  const check = await s3.send(new ListObjectsV2Command({ Bucket, Prefix, MaxKeys: 1 }));
  if ((check.KeyCount ?? 0) > 0) throw new Error('deletion_not_verified');
}
