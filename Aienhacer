import sharp from 'sharp';
import { createHash } from 'node:crypto';
import { cfg } from './config.js';
import { db, setJob } from './db.js';
import { analyze, toWorkPng, type Analysis, type FaceBox } from './analyze.js';
import { buildPlan, saferPlan, type Plan, type Step } from './router.js';
import { runModel, inputFor, PermanentError, TransientError } from './providers/replicate.js';
import { getBuffer, putBuffer, presignGet, keys, deletePrefix } from './store.js';
import { identity } from './identity.js';
import { runQc } from './qc.js';
import { MODES } from './modes.js';
import { refund } from './quota.js';

const sha256 = (b: Buffer) => createHash('sha256').update(b).digest('hex');

export async function processJob(jobId: string): Promise<void> {
  const job = await db.one('select j.*, u.plan from jobs j join users u on u.id=j.user_id where j.id=$1', [jobId]);
  if (!job || job.status !== 'queued') return;                  // duplicate-delivery guard
  const tier = job.plan as 'free' | 'premium';
  try {
    await setJob(jobId, { status: 'analyzing', progress: 5 });
    const original = await getBuffer(job.original_key);
    const work = await toWorkPng(original);
    const a = await analyze(work, original.length);

    const first = buildPlan(job.mode, a, { tier, faceRestore: job.face_restore });
    const ladder: Plan[] = [first, saferPlan(first, 1, a, tier), saferPlan(first, 2, a, tier)];
    const diagnostics: unknown[] = [];

    for (let i = 0; i < ladder.length; i++) {
      const plan = ladder[i];
      await setJob(jobId, { attempts: i + 1, plan, progress: 10 });
      try {
        const r = await render(job, work, a, plan);
        const qc = await runQc({
          output: r.image, baseline: r.baseline, expected: plan.target,
          originalAspect: a.width / a.height, mode: job.mode, faces: r.faces, identityResults: r.identity,
        });
        diagnostics.push({ attempt: i + 1, qc });
        if (!qc.pass) continue;                               // retry with a safer configuration

        await setJob(jobId, { status: 'checking', progress: 94 });
        const out = await encode(r.image, job.export_format);
        const ext = job.export_format === 'png' ? 'png' : 'jpg';
        const key = keys.output(job.user_id, jobId, ext);
        await putBuffer(key, out, job.export_format === 'png' ? 'image/png' : 'image/jpeg');

        // verify the stored object, not our in-memory copy
        const stored = await getBuffer(key);
        const meta = await sharp(stored).metadata();
        if (sha256(stored) !== sha256(out) || meta.width !== plan.target.w || meta.height !== plan.target.h)
          throw new TransientError('stored_output_mismatch');

        const longEdge = Math.max(meta.width!, meta.height!);
        const label = job.mode === 'upscale_4k' && longEdge >= 3840 ? '4K' : null;   // computed from real pixels
        await setJob(jobId, {
          status: 'succeeded', progress: 100, output_key: key, output_bytes: stored.length,
          output_w: meta.width, output_h: meta.height, output_sha256: sha256(stored),
          output_label: label, qc: diagnostics,
        });
        await deletePrefix(`${keys.prefix(job.user_id, jobId)}work/`);        // intermediates are gone right away
        return;
      } catch (e) {
        if (e instanceof PermanentError && e.code === 'not_configured') throw e;
        diagnostics.push({ attempt: i + 1, error: String((e as Error).message) });
        if (i === ladder.length - 1) throw e;
      }
    }
    throw new PermanentError('qc_failed', 'quality_check_failed');
  } catch (e) {
    await fail(job, e);
  }
}

async function render(job: any, work: Buffer, a: Analysis, plan: Plan) {
  const base = await sharp(work).resize(plan.target.w, plan.target.h, { kernel: 'lanczos3' }).png().toBuffer();

  // ---- AI steps on an input capped to MAX_AI_INPUT_EDGE
  let cur = work;
  const sr = plan.steps.length > 0;
  if (sr) {
    const meta = await sharp(work).metadata();
    if (Math.max(meta.width!, meta.height!) > cfg.MAX_AI_INPUT_EDGE) {
      cur = await sharp(work).resize({ width: cfg.MAX_AI_INPUT_EDGE, height: cfg.MAX_AI_INPUT_EDGE, fit: 'inside' }).png().toBuffer();
    }
  }
  let n = 0;
  for (const step of plan.steps) {
    n++;
    await setJob(job.id, { status: 'enhancing', progress: 10 + Math.round((n / plan.steps.length) * 55) });
    cur = await runStep(job, step, cur, `s${n}`);
  }
  let enhanced = await sharp(cur).resize(plan.target.w, plan.target.h, { kernel: 'lanczos3' }).toColourspace('srgb').png().toBuffer();

  // ---- non-generative local ops
  let pipe = sharp(enhanced);
  if (plan.localOps.autoLevels) pipe = pipe.normalise({ lower: 1, upper: 99 });
  if (plan.localOps.gamma) pipe = pipe.gamma(plan.localOps.gamma);
  if (plan.localOps.sharpen) pipe = pipe.sharpen({ sigma: 0.8, m1: plan.localOps.sharpen, m2: 1 });
  enhanced = await pipe.png().toBuffer();

  // ---- intensity: real blend between the plain-resize baseline and the enhanced result
  const k = job.intensity / 100;
  let image = k >= 0.999 ? enhanced : await sharp(base)
    .composite([{ input: await sharp(enhanced).ensureAlpha(k).png().toBuffer(), blend: 'over' }]).png().toBuffer();

  // ---- faces
  let faces: FaceBox[] = [];
  let idResults: { similarity: number | null; accepted: boolean }[] = [];
  if (plan.faces !== 'off' && job.face_restore) {
    await setJob(job.id, { status: 'face_restoring', progress: 75 });
    const r = await restoreFaces(job, image, plan, job.face_strength / 100);
    image = r.image; faces = r.faces; idResults = r.results;
  }
  return { image, baseline: base, faces, identity: idResults };
}

async function runStep(job: any, step: Step, input: Buffer, name: string): Promise<Buffer> {
  const key = keys.work(job.user_id, job.id, name);
  await putBuffer(key, input, 'image/png');
  const url = await presignGet(key, 600);                  // short-lived URL for the provider only
  switch (step.kind) {
    case 'sr':       return runModel('esrgan', inputFor.esrgan(url, step.scale), job.id);
    case 'jpeg':     return runModel('swinir', inputFor.swinir(url, 'jpeg', step.quality), job.id);
    case 'denoise':  return runModel('swinir', inputFor.swinir(url, 'denoise', step.level), job.id);
    case 'deblur':   return runModel('nafnet', inputFor.nafnet(url), job.id);
    case 'oldphoto': return runModel('oldphoto', inputFor.oldphoto(url), job.id);
  }
}

/** Identity thresholds are starting values. Calibrate them with your own consented test set. */
const SIM_ACCEPT = 0.85, SIM_PARTIAL = 0.70;

async function restoreFaces(job: any, img: Buffer, plan: Plan, strength: number) {
  const meta = await sharp(img).metadata();
  const W = meta.width!, H = meta.height!;
  const results: { similarity: number | null; accepted: boolean }[] = [];
  let out = img;

  let boxes: FaceBox[];
  if (plan.faces === 'whole-image-fallback') boxes = [{ x: 0, y: 0, w: W, h: H, score: 1 }];
  else boxes = (await identity.detect(img)).faces.filter((f) => f.w >= 48 && f.h >= 48)
    .sort((a, b) => b.w * b.h - a.w * a.h).slice(0, 6);

  for (const [i, f] of boxes.entries()) {
    const m = plan.faces === 'whole-image-fallback' ? 0 : Math.round(Math.max(f.w, f.h) * 0.4);
    const left = Math.max(0, Math.round(f.x) - m), top = Math.max(0, Math.round(f.y) - m);
    const width = Math.min(W - left, Math.round(f.w) + 2 * m), height = Math.min(H - top, Math.round(f.h) + 2 * m);
    const crop = await sharp(out).extract({ left, top, width, height }).png().toBuffer();

    let restored: Buffer;
    try { restored = await runStep(job, { kind: 'sr', scale: 2 } as Step, crop, `f${i}`).then(() => crop); }
    catch { restored = crop; }
    // run the actual face model on the crop (CodeFormer, conservative fidelity)
    try {
      const key = keys.work(job.user_id, job.id, `face${i}`);
      await putBuffer(key, crop, 'image/png');
      restored = await runModel('codeformer', inputFor.codeformer(await presignGet(key, 600), plan.faceFidelity), job.id);
      restored = await sharp(restored).resize(width, height, { fit: 'fill', kernel: 'lanczos3' }).png().toBuffer();
    } catch { results.push({ similarity: null, accepted: false }); continue; }

    let alpha: number, sim: number | null = null;
    if (plan.faces === 'whole-image-fallback') { alpha = 0.6; }
    else {
      sim = await identity.similarity(crop, restored);
      alpha = sim === null ? 0 : sim >= SIM_ACCEPT ? 1 : sim >= SIM_PARTIAL ? 0.5 : 0;
    }
    alpha *= strength;
    results.push({ similarity: sim, accepted: alpha > 0 });
    if (alpha <= 0) continue;                              // identity not confidently preserved, so we keep the original face

    // feathered elliptical mask, so only the face blends in
    const svg = `<svg xmlns="http://www.w3.org/2000/svg" width="${width}" height="${height}">
      <defs><filter id="b"><feGaussianBlur stdDeviation="${Math.max(2, Math.round(Math.min(width, height) * 0.04))}"/></filter></defs>
      <rect width="100%" height="100%" fill="black"/>
      <ellipse cx="${width / 2}" cy="${height / 2}" rx="${width * 0.36}" ry="${height * 0.42}" fill="white" fill-opacity="${alpha}" filter="url(#b)"/></svg>`;
    const mask = await sharp(Buffer.from(svg)).greyscale().raw().toBuffer({ resolveWithObject: true });
    const patch = await sharp(restored).removeAlpha()
      .joinChannel(mask.data, { raw: { width: mask.info.width, height: mask.info.height, channels: 1 } })
      .png().toBuffer();
    out = await sharp(out).composite([{ input: patch, left, top, blend: 'over' }]).png().toBuffer();
  }
  return { image: out, faces: boxes, results };
}

const encode = (img: Buffer, fmt: 'png' | 'jpeg') =>
  fmt === 'png'
    ? sharp(img).png({ compressionLevel: 6 }).toBuffer()
    : sharp(img).jpeg({ quality: 95, chromaSubsampling: '4:4:4', mozjpeg: true }).toBuffer();

