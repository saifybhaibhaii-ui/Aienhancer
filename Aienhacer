import { cfg } from './config.js';
import type { Analysis } from './analyze.js';
import { MODES, type ModeId } from './modes.js';

export type Step =
  | { kind: 'oldphoto' }
  | { kind: 'deblur' }
  | { kind: 'jpeg'; quality: number }
  | { kind: 'denoise'; level: 15 | 25 | 50 }
  | { kind: 'sr'; scale: 2 | 4 };

export interface Plan {
  mode: ModeId;
  steps: Step[];
  target: { w: number; h: number };
  faces: 'off' | 'crop' | 'whole-image-fallback';
  faceFidelity: number;
  localOps: { autoLevels: boolean; gamma?: number; sharpen?: number };
  reasons: string[];       // shown to the user: why we did what we did
  safer: boolean;
}

const noiseLevel = (s: number): 15 | 25 | 50 | null =>
  s < 8 ? null : s < 18 ? 15 : s < 35 ? 25 : 50;

export function buildPlan(
  modeId: ModeId, a: Analysis,
  opts: { tier: 'free' | 'premium'; faceRestore: boolean },
): Plan {
  const m = MODES[modeId];
  const reasons: string[] = [];
  const steps: Step[] = [];
  const tooLarge = a.long > cfg.MAX_AI_INPUT_EDGE;

  // ----- scale choice
  let scale: 1 | 2 | 4 = 1;
  if (tooLarge) {
    reasons.push(`This photo is already ${a.long}px on its long edge, so AI upscaling was skipped to keep the original detail.`);
  } else {
    switch (modeId) {
      case 'natural_hd': case 'blur_remover': case 'old_photo': scale = 2; break;
      case 'ultra_hd': scale = 4; break;
      case 'upscale_4k': scale = a.long * 2 >= 3840 ? 2 : 4; break;
      case 'face_restore': case 'original': scale = a.long < 1024 ? 2 : 1; break;
      case 'social': scale = a.long < 1080 ? 2 : 1; break;
      case 'noise_cleaner': scale = 1; break;
    }
  }

  // ----- restoration steps, ordered: repair -> deblur -> artifacts -> noise -> upscale
  const faded = a.contrastSpan < 150;
  if (modeId === 'old_photo' && !tooLarge) {
    steps.push({ kind: 'oldphoto' });
    reasons.push('Scratch and dust repair applied for the old-photo mode.');
  }
  if (modeId === 'blur_remover' && !tooLarge) {
    if (a.sharpness < 120) { steps.push({ kind: 'deblur' }); reasons.push('Photo measured as soft, so a dedicated deblur model runs before upscaling.'); }
    else reasons.push('Photo is already fairly sharp, so deblurring was skipped.');
  }
  const heavyCompression = a.bytesPerPixel < 0.6;
  if (!tooLarge && (heavyCompression || modeId === 'noise_cleaner' && a.bytesPerPixel < 1.2)) {
    steps.push({ kind: 'jpeg', quality: heavyCompression ? 20 : 40 });
    reasons.push('Compression artifacts detected, so JPEG artifact reduction was added.');
  }
  const nl = noiseLevel(a.noiseSigma) ?? (modeId === 'noise_cleaner' ? 15 : null);
  if (!tooLarge && nl && modeId !== 'original') {
    steps.push({ kind: 'denoise', level: nl });
    reasons.push(`Noise level measured (sigma≈${a.noiseSigma.toFixed(1)}), so denoise strength ${nl} was chosen.`);
  }
  if (scale > 1) steps.push({ kind: 'sr', scale: scale as 2 | 4 });

  // ----- target dimensions
  const tierCap = opts.tier === 'premium' ? cfg.PREMIUM_MAX_OUTPUT_EDGE : cfg.FREE_MAX_OUTPUT_EDGE;
  let longTarget = a.long * scale;
  if (scale > 1) {
    longTarget = Math.min(longTarget, tierCap);
    if (modeId === 'upscale_4k') longTarget = Math.min(longTarget, 3840);
    if (modeId === 'social') longTarget = Math.min(longTarget, 1440);
  }
  const f = longTarget / a.long;
  const target = { w: Math.max(1, Math.round(a.width * f)), h: Math.max(1, Math.round(a.height * f)) };
  if (modeId === 'upscale_4k' && Math.max(target.w, target.h) < 3840) {
    reasons.push(`The source is too small to reach a true 4K long edge in one pass. The output will be ${target.w}×${target.h} and labelled with its real size.`);
  }

  // ----- faces
  let faces: Plan['faces'] = 'off';
  const wantsFaces = opts.faceRestore && !tooLarge;
  if (wantsFaces && a.faceDetectorAvailable && a.faces.length > 0) {
    faces = 'crop';
    reasons.push(`${a.faces.length} face(s) found. Each is restored separately and kept only if it still matches the original person.`);
  } else if (wantsFaces && modeId === 'face_restore' && !a.faceDetectorAvailable) {
    faces = 'whole-image-fallback';
    reasons.push('Face detector unavailable. Conservative whole-image face restoration used and the identity check could not run.');
  } else if (opts.faceRestore && a.faceDetectorAvailable && a.faces.length === 0) {
    reasons.push('No faces detected, so face restoration was skipped.');
  } else if (opts.faceRestore && !a.faceDetectorAvailable) {
    reasons.push('Face restoration skipped because the identity check is unavailable.');
  }

  // ----- local, non-generative ops
  const dark = a.meanLuma < 70;
  const localOps = {
    autoLevels: (modeId === 'old_photo' && faded) || (modeId === 'social' && faded),
    gamma: dark && modeId !== 'original' ? Math.min(2.0, Math.max(1.1, Math.log(0.4) / Math.log(Math.max(a.meanLuma, 20) / 255))) : undefined,
    sharpen: modeId === 'blur_remover' ? 0.6 : undefined,
  };
  if (localOps.gamma) reasons.push('Photo is dark, so exposure was lifted with a gentle gamma curve.');
  if (localOps.autoLevels) reasons.push('Low contrast detected, so levels were stretched.');

  return { mode: modeId, steps, target, faces, faceFidelity: m.faceFidelity, localOps, reasons, safer: false };
}

/** Retry ladder: drop face restoration and generative extras, then fall back to the most conservative plan. */
export function saferPlan(p: Plan, level: 1 | 2, a: Analysis, tier: 'free' | 'premium'): Plan {
  if (level === 1) {
    return {
      ...p, faces: 'off', safer: true,
      steps: p.steps.filter((s) => s.kind === 'sr' || s.kind === 'denoise'),
      localOps: { ...p.localOps, sharpen: undefined },
      reasons: [...p.reasons, 'First attempt failed our quality checks, so a safer configuration was used (face restoration off).'],
    };
  }
  const orig = buildPlan('original', a, { tier, faceRestore: false });
  return { ...orig, reasons: [...p.reasons, 'Fell back to the most conservative enhancement.'], safer: true };
}
