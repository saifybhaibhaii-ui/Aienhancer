import { useRef, useState, useCallback } from 'react';

/**
 * Both images share ONE transform, so zoom and pan are identical by construction.
 * The original is drawn into the same CSS box as the enhanced image, so a 600px original
 * and a 2400px result line up pixel for pixel in the viewport.
 */
export function Compare(props: {
  originalUrl: string; enhancedUrl: string;
  originalDims: string; enhancedDims: string; enhancedBytes: string;
}) {
  const [split, setSplit] = useState(50);
  const [view, setView] = useState({ s: 1, x: 0, y: 0 });
  const root = useRef<HTMLDivElement>(null);
  const pointers = useRef(new Map<number, { x: number; y: number }>());
  const last = useRef<{ d: number } | null>(null);

  const zoomAt = useCallback((cx: number, cy: number, factor: number) => {
    setView((v) => {
      const s = Math.min(16, Math.max(1, v.s * factor));
      const k = s / v.s;
      return s === 1 ? { s: 1, x: 0, y: 0 } : { s, x: cx - (cx - v.x) * k, y: cy - (cy - v.y) * k };
    });
  }, []);

  const onWheel = (e: React.WheelEvent) => {
    const r = root.current!.getBoundingClientRect();
    zoomAt(e.clientX - r.left, e.clientY - r.top, e.deltaY < 0 ? 1.15 : 1 / 1.15);
  };
  const onDown = (e: React.PointerEvent) => { (e.target as Element).setPointerCapture(e.pointerId); pointers.current.set(e.pointerId, { x: e.clientX, y: e.clientY }); };
  const onMove = (e: React.PointerEvent) => {
    const p = pointers.current.get(e.pointerId); if (!p) return;
    const prev = { ...p }; p.x = e.clientX; p.y = e.clientY;
    if (pointers.current.size === 2) {                                  // pinch
      const [a, b] = [...pointers.current.values()];
      const d = Math.hypot(a.x - b.x, a.y - b.y);
      if (last.current) {
        const r = root.current!.getBoundingClientRect();
        zoomAt((a.x + b.x) / 2 - r.left, (a.y + b.y) / 2 - r.top, d / last.current.d);
      }
      last.current = { d };
    } else if (view.s > 1) {                                            // pan
      setView((v) => ({ ...v, x: v.x + e.clientX - prev.x, y: v.y + e.clientY - prev.y }));
    }
  };
  const onUp = (e: React.PointerEvent) => { pointers.current.delete(e.pointerId); last.current = null; };

  const onHandle = (e: React.PointerEvent) => {
    e.stopPropagation();
    const el = root.current!, r = el.getBoundingClientRect();
    const move = (ev: PointerEvent) => setSplit(Math.min(100, Math.max(0, ((ev.clientX - r.left) / r.width) * 100)));
    const up = () => { window.removeEventListener('pointermove', move); window.removeEventListener('pointerup', up); };
    window.addEventListener('pointermove', move); window.addEventListener('pointerup', up);
  };

  const stage: React.CSSProperties = { position: 'absolute', inset: 0, transformOrigin: '0 0', transform: `translate(${view.x}px,${view.y}px) scale(${view.s})` };
  const img: React.CSSProperties = { width: '100%', height: '100%', objectFit: 'contain', userSelect: 'none', pointerEvents: 'none' };

  return (
    <figure className="compare">
      <div ref={root} className="compare-frame" onWheel={onWheel} onPointerDown={onDown} onPointerMove={onMove} onPointerUp={onUp}
           style={{ position: 'relative', overflow: 'hidden', touchAction: 'none', aspectRatio: '4/3', borderRadius: 20, background: '#0b0b0f' }}>
        <div style={stage}><img src={props.enhancedUrl} alt="Enhanced" style={img} draggable={false} /></div>
        {/* clip wrapper lives OUTSIDE the transform, so the divider stays vertical while content zooms */}
        <div style={{ position: 'absolute', inset: 0, clipPath: `inset(0 ${100 - split}% 0 0)` }}>
          <div style={stage}><img src={props.originalUrl} alt="Original" style={img} draggable={false} /></div>
        </div>
        <div role="slider" aria-label="Before and after" aria-valuenow={Math.round(split)} tabIndex={0}
             onPointerDown={onHandle}
             onKeyDown={(e) => e.key === 'ArrowLeft' ? setSplit((s) => Math.max(0, s - 2)) : e.key === 'ArrowRight' && setSplit((s) => Math.min(100, s + 2))}
             style={{ position: 'absolute', top: 0, bottom: 0, left: `${split}%`, width: 44, marginLeft: -22, cursor: 'ew-resize', display: 'grid', placeItems: 'center' }}>
          <div style={{ width: 2, height: '100%', background: '#fff', boxShadow: '0 0 0 1px #0004' }} />
          <div style={{ position: 'absolute', width: 36, height: 36, borderRadius: 18, background: '#7c5cff', border: '2px solid #fff' }} />
        </div>
        <span className="tag" style={{ position: 'absolute', left: 12, bottom: 12 }}>Original · {props.originalDims}</span>
        <span className="tag" style={{ position: 'absolute', right: 12, bottom: 12 }}>Enhanced · {props.enhancedDims} · {props.enhancedBytes}</span>
        {view.s > 1 && <button onClick={() => setView({ s: 1, x: 0, y: 0 })} style={{ position: 'absolute', top: 12, right: 12 }}>Reset zoom</button>}
      </div>
    </figure>
  );
}
// tests/qc.test.ts
import { describe, it, expect } from 'vitest';
import sharp from 'sharp';
import { runQc } from '../apps/api/src/qc.js';

async function photoLike(w: number, h: number) {
  const noise = Buffer.alloc(w * h * 3);
  for (let i = 0; i < noise.length; i++) noise[i] = 100 + ((i * 2654435761) % 55);
  return sharp(noise, { raw: { width: w, height: h, channels: 3 } }).blur(1.2).png().toBuffer();
}
const base = { faces: [], identityResults: [], mode: 'natural_hd' as const };

describe('quality control', () => {
  it('passes a faithful output', async () => {
    const b = await photoLike(800, 600);
    const r = await runQc({ ...base, output: b, baseline: b, expected: { w: 800, h: 600 }, originalAspect: 4 / 3 });
    expect(r.pass).toBe(true);
  });
  it('fails wrong dimensions', async () => {
    const b = await photoLike(800, 600);
    const small = await sharp(b).resize(400, 300).png().toBuffer();
    const r = await runQc({ ...base, output: small, baseline: b, expected: { w: 800, h: 600 }, originalAspect: 4 / 3 });
    expect(r.checks.find((c) => c.name === 'dimensions')!.pass).toBe(false);
  });
  it('fails a blanked-out region', async () => {
    const b = await photoLike(800, 600);
    const hole = await sharp({ create: { width: 300, height: 300, channels: 3, background: '#000' } }).png().toBuffer();
    const out = await sharp(b).composite([{ input: hole, left: 100, top: 100 }]).png().toBuffer();
    const r = await runQc({ ...base, output: out, baseline: b, expected: { w: 800, h: 600 }, originalAspect: 4 / 3 });
    expect(r.pass).toBe(false);
  });
  it('fails a corrupted file', async () => {
    const b = await photoLike(800, 600);
    const r = await runQc({ ...base, output: b.subarray(0, 200), baseline: b, expected: { w: 800, h: 600 }, originalAspect: 4 / 3 });
    expect(r.pass).toBe(false);
  });
  it('fails an over-sharpened output', async () => {
    const b = await photoLike(800, 600);
    const out = await sharp(b).sharpen({ sigma: 3, m1: 20, m2: 20 }).png().toBuffer();
    const r = await runQc({ ...base, output: out, baseline: b, expected: { w: 800, h: 600 }, originalAspect: 4 / 3 });
    expect(r.checks.find((c) => c.name === 'sharpness')!.pass).toBe(false);
  });
});
// tests/router.test.ts
import { describe, it, expect } from 'vitest';
import { buildPlan } from '../apps/api/src/router.js';

const A = (o: any = {}) => ({ width: 800, height: 600, long: 800, sharpness: 200, noiseSigma: 2, meanLuma: 120,
  contrastSpan: 220, bytesPerPixel: 1.5, faces: [], faceDetectorAvailable: true, ...o });
const opts = { tier: 'premium' as const, faceRestore: true };

describe('routing', () => {
  it('never labels a too-small source as 4K', () => {
    const p = buildPlan('upscale_4k', A({ long: 500, width: 500, height: 375 }), opts);
    expect(Math.max(p.target.w, p.target.h)).toBe(2000);
    expect(p.reasons.join(' ')).toMatch(/too small to reach a true 4K/);
  });
  it('reaches exactly 3840 when the source allows it', () => {
    const p = buildPlan('upscale_4k', A({ long: 1600, width: 1600, height: 1200 }), opts);
    expect(p.target).toEqual({ w: 3840, h: 2880 });
  });
  it('skips noise and JPEG models on a clean image', () => {
    const p = buildPlan('natural_hd', A(), opts);
    expect(p.steps.map((s) => s.kind)).toEqual(['sr']);
  });
  it('skips face restoration when no face is found, and when the toggle is off', () => {
    expect(buildPlan('face_restore', A(), opts).faces).toBe('off');
    expect(buildPlan('face_restore', A({ faces: [{ x: 1, y: 1, w: 90, h: 90, score: 1 }] }), { ...opts, faceRestore: false }).faces).toBe('off');
  });
  it('does not upscale already-large photos', () => {
    const p = buildPlan('ultra_hd', A({ long: 4000, width: 4000, height: 3000 }), opts);
    expect(p.steps).toEqual([]);
    expect(p.target).toEqual({ w: 4000, h: 3000 });
  });
  it('caps free-tier output edge', () => {
    const p = buildPlan('natural_hd', A({ long: 1500, width: 1500, height: 1125 }), { tier: 'free', faceRestore: false });
    expect(Math.max(p.target.w, p.target.h)).toBeLessThanOrEqual(2048);
  });
});


