};

export async function runModel(
  model: ModelKey, input: Record<string, unknown>, jobId: string, timeoutMs = 180_000,
): Promise<Buffer> {
  const version = cfg.REPLICATE_VERSIONS[model];
  if (!version) throw new PermanentError(`No pinned version for ${model}`, 'not_configured');
  for (let attempt = 0; ; attempt++) {
    try { return await once(model, version, input, jobId, timeoutMs); }
    catch (e) {
      if (e instanceof TransientError && attempt < 2) {
        await sleep(2000 * 2 ** attempt + Math.random() * 500);
        continue;
      }
      throw e;
    }
  }
}

async function once(model: ModelKey, version: string, input: Record<string, unknown>, jobId: string, timeoutMs: number) {
  let pred;
  try { pred = await replicate.predictions.create({ version, input }); }
  catch (e: any) {
    const st = e?.response?.status;
    if (st === 429 || st >= 500) throw new TransientError(`create_${st}`);
    throw new PermanentError(`create_failed_${st ?? 'unknown'}`);
  }
  const deadline = Date.now() + timeoutMs;
  while (!['succeeded', 'failed', 'canceled'].includes(pred.status)) {
    if (Date.now() > deadline) {
      await replicate.predictions.cancel(pred.id).catch(() => {});
      throw new TransientError('model_timeout');
    }
    await sleep(1500);
    try { pred = await replicate.predictions.get(pred.id); } catch { /* transient poll error, keep trying until the deadline */ }
  }
  const seconds = (pred.metrics as any)?.predict_time as number | undefined;
  const cost = seconds ? seconds * (cfg.PRICE_PER_SECOND[model] ?? 0) : null;
  await db.query('insert into provider_calls(job_id,model,seconds,est_cost_usd,ok) values($1,$2,$3,$4,$5)',
    [jobId, model, seconds ?? null, cost, pred.status === 'succeeded']);

  if (pred.status !== 'succeeded') {
    const msg = String(pred.error ?? '');
    if (/out of memory|oom|too large|exceeds/i.test(msg)) throw new PermanentError(msg, 'image_too_large');
    throw new TransientError(msg || pred.status);
  }
  const url = Array.isArray(pred.output) ? pred.output[0] : pred.output;
  if (typeof url !== 'string') throw new PermanentError('unexpected_output_shape');
  const r = await fetch(url, { signal: AbortSignal.timeout(60_000) });
  if (!r.ok) throw new TransientError(`output_fetch_${r.status}`);
  if (Number(r.headers.get('content-length') ?? 0) > 250 * 1024 * 1024) throw new PermanentError('output_too_large');
  return Buffer.from(await r.arrayBuffer());   // re-stored by us. Provider URLs never reach the client.
}
