export const dailyLimit = (plan: string) => plan === 'premium' ? cfg.PREMIUM_DAILY_CREDITS : cfg.FREE_DAILY_CREDITS;

/** Atomic: succeeds only if the user stays within the limit, so there are no race conditions. */
export async function reserve(client: any, userId: string, plan: string, cost: number): Promise<boolean> {
  const r = await client.query(
    `insert into usage_daily(user_id, day, used) values ($1, (now() at time zone 'utc')::date, $2)
     on conflict (user_id, day) do update set used = usage_daily.used + $2
       where usage_daily.used + $2 <= $3
     returning used`, [userId, cost, dailyLimit(plan)]);
  return r.rowCount === 1;
}

