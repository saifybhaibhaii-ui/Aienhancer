// apps/web/src/api.ts
const API = import.meta.env.VITE_API_URL;
const sleep = (ms: number) => new Promise((r) => setTimeout(r, ms));
let token = () => localStorage.getItem('token') ?? '';

async function call(path: string, init: RequestInit = {}) {
  const r = await fetch(API + path, { ...init, headers: { ...(init.headers as any), authorization: `Bearer ${token()}`, 'content-type': 'application/json' } });
  const body = await r.json().catch(() => ({}));
  if (!r.ok) throw Object.assign(new Error(body.message ?? 'Request failed'), body);
  return body;
}

export function uploadWithProgress(post: { url: string; fields: Record<string, string> }, file: File, onProgress: (p: number) => void) {
  return new Promise<void>((resolve, reject) => {
    const fd = new FormData();
    Object.entries(post.fields).forEach(([k, v]) => fd.append(k, v));
    fd.append('file', file);                                   // the file must be the last field
    const x = new XMLHttpRequest();
    x.open('POST', post.url);
    x.timeout = 120_000;
    x.upload.onprogress = (e) => e.lengthComputable && onProgress(e.loaded / e.total);
    x.onload = () => (x.status < 300 ? resolve() : reject(new Error('Upload failed. Please try again.')));
    x.onerror = x.ontimeout = () => reject(new Error('Upload interrupted. Check your connection and retry.'));
    x.send(fd);
  });
}

/** Call once per click. Reusing `idem` on a retry means a double tap can never double-charge. */
export async function enhance(file: File, opts: any, idem: string, on: (s: string, p: number) => void) {
  const { job, upload } = await call('/v1/jobs', {
    method: 'POST', headers: { 'idempotency-key': idem },
    body: JSON.stringify({ ...opts, contentType: file.type || 'image/jpeg', consent: { processing: true, training: false } }),
  });
  on('uploading', 0);
  await uploadWithProgress(upload, file, (p) => on('uploading', p * 100));
  await call(`/v1/jobs/${job.id}/start`, { method: 'POST' });

  const deadline = Date.now() + 10 * 60_000;                   // never an infinite spinner
  let delay = 1000;
  while (Date.now() < deadline) {
    const j = await call(`/v1/jobs/${job.id}`);
    on(j.status, j.progress);
    if (j.status === 'succeeded') return j;
    if (j.status === 'failed') throw Object.assign(new Error(j.error.message), j.error);
    await sleep(delay); delay = Math.min(delay * 1.3, 4000);
  }
  throw new Error('This is taking longer than expected. You can leave this page and check Recent Projects. Your photo is still safe.');
}

/** Download with retries, then verify the SHA-256 the server recorded before offering the file. */
export async function downloadVerified(jobId: string, variant: 'output' | 'original') {
  let lastErr: unknown;
  for (let attempt = 0; attempt < 4; attempt++) {
    try {
      const { url, sha256 } = await call(`/v1/jobs/${jobId}/files/${variant}`);   // a fresh signed URL on every attempt
      const r = await fetch(url);
      if (!r.ok) throw new Error(`HTTP ${r.status}`);
      const blob = await r.blob();
      const digest = [...new Uint8Array(await crypto.subtle.digest('SHA-256', await blob.arrayBuffer()))]
        .map((b) => b.toString(16).padStart(2, '0')).join('');
      if (sha256 && digest !== sha256) throw new Error('Downloaded file failed its integrity check');
      return blob;
    } catch (e) { lastErr = e; await sleep(800 * 2 ** attempt); }
  }
  throw new Error(`Download failed after several attempts. ${(lastErr as Error).message}`);
}
